    },
    {
      "id": "writer",
      "name": "Reply writer",
      "model": "fast",
      "system": "Write a short, friendly customer reply.",
      "handoff_reason": "send the reply"
    }
  ],
  "flow": [
    "triage",
    "billing",
    "writer"
  ]
