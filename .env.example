# necto server configuration (copy to .env and adjust)
NECTO_DATABASE_URL=postgresql+psycopg://necto:necto@127.0.0.1:5432/necto
NECTO_LOG_LEVEL=info

# Optional: require an X-API-Key header on every /v1 endpoint (incl. the WebSocket).
# Leave empty/unset for local development.
# NECTO_API_KEY=

# Optional: on first boot, fill an empty database with realistic demo runs
# (a support pipeline with an intentional silent handoff failure).
# NECTO_SEED=1
